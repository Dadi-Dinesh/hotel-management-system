# Render Express Server URL (Use http://localhost:4000 for local development testing, or your production Render URL)
BACKEND_URL=https://hotel-management-system-backend.onrender.com

# Shared API Key authentication for Printer Agent connection
PRINTER_AGENT_KEY=nookambika_printer_secret_key_2026

# Physical Printer Hardware Defaults
PRINTER_PORT=/dev/cu.usbserial-110
PRINTER_BAUD_RATE=9600

# Kitchen Mode Default (LIVE | NORMAL)
KITCHEN_MODE=LIVE

# Target Printer Configuration (ALL | RECEIPT | KOT)
PRINTER_TARGET=ALL
