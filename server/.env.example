NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/servesync_local
JWT_SECRET=
CLIENT_URL=http://localhost:3000

# Optional image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional demo thermal agent. Leave empty to deny agent connections.
PRINTER_AGENT_KEY=

# Optional messaging provider. Configure only the selected provider.
WHATSAPP_PROVIDER=
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=

# Only for the isolated servesync_demo seed
DEMO_SEED_PASSWORD=
